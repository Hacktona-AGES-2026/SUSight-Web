{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "speak": "${altText}",
  "body": [
    {
      "type": "ColumnSet",
      "columns": [
        {
          "type": "Column",
          "width": "auto",
          "items": [
            {
              "type": "Image",
              "url": "/widgets/icon-64.png",
              "width": "24px",
              "altText": ""
            }
          ]
        },
        {
          "type": "Column",
          "width": "stretch",
          "verticalContentAlignment": "Center",
          "items": [
            { "type": "TextBlock", "text": "Aprovações", "weight": "Bolder" }
          ]
        }
      ]
    },
    {
      "type": "TextBlock",
      "$when": "${signedIn}",
      "text": "${count}",
      "size": "ExtraLarge",
      "weight": "Bolder",
      "spacing": "Medium"
    },
    {
      "type": "TextBlock",
      "$when": "${signedIn}",
      "text": "${label}",
      "isSubtle": true,
      "wrap": true,
      "spacing": "None"
    },
    {
      "type": "TextBlock",
      "$when": "${!signedIn}",
      "text": "${message}",
      "wrap": true,
      "spacing": "Medium"
    }
  ],
  "actions": [
    {
      "type": "Action.Execute",
      "title": "${buttonText}",
      "verb": "open",
      "data": { "url": "${url}" },
      "style": "positive"
    }
  ]
}
