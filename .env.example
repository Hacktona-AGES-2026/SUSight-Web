# Fonte de dados: "mock" (dados de demonstração, sem backend) ou "api" (SUSight-Backend).
NEXT_PUBLIC_DATA_SOURCE=mock

# Endereço do SUSight-Backend, usado quando NEXT_PUBLIC_DATA_SOURCE=api.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Avisos por Web Push (spec 010). Gere um par de chaves com:
#   pnpm dlx web-push generate-vapid-keys
# A chave pública vai para o navegador; a privada fica só no servidor e nunca vai para o git.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:equipe@susight.example
